<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/note_card"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:padding="12dp" android:orientation="vertical" android:background="@drawable/note_bg">
  <TextView android:id="@+id/note_title" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:textColor="#252923"
    android:textStyle="bold" android:textSize="15sp" android:maxLines="2" android:ellipsize="end"/>
  <TextView android:id="@+id/note_body" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="4dp"
    android:textColor="#4F554D" android:textSize="13sp" android:maxLines="3" android:ellipsize="end"/>
  <TextView android:id="@+id/note_check1" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:minHeight="29dp" android:gravity="center_vertical"
    android:textSize="13sp" android:textColor="#444B42"/>
  <TextView android:id="@+id/note_check2" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:minHeight="29dp" android:gravity="center_vertical"
    android:textSize="13sp" android:textColor="#444B42"/>
  <TextView android:id="@+id/note_check3" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:minHeight="29dp" android:gravity="center_vertical"
    android:textSize="13sp" android:textColor="#444B42"/>
  <TextView android:id="@+id/note_footer" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="3dp"
    android:textColor="#697665" android:textSize="11sp" android:maxLines="1"/>
</LinearLayout>
