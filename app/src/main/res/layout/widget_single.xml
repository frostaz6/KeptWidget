<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/single_root"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="10dp"
  android:background="@drawable/widget_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
    android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/single_title" android:layout_width="0dp"
      android:layout_height="match_parent" android:layout_weight="1"
      android:gravity="center_vertical" android:paddingStart="8dp"
      android:text="Choose a note" android:textSize="17sp"
      android:textColor="#263824" android:textStyle="bold"
      android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/single_edit" android:layout_width="40dp"
      android:layout_height="match_parent" android:gravity="center"
      android:text="✎" android:textSize="22sp" android:textColor="#344C2B"
      android:contentDescription="Edit this note"/>
    <TextView android:id="@+id/single_refresh" android:layout_width="40dp"
      android:layout_height="match_parent" android:gravity="center"
      android:text="↻" android:textSize="25sp" android:textColor="#516847"
      android:contentDescription="Refresh this note"/>
  </LinearLayout>
  <ListView android:id="@+id/single_items" android:layout_width="match_parent"
    android:layout_height="0dp" android:layout_weight="1"
    android:divider="#EBEAE5" android:dividerHeight="1dp"
    android:paddingStart="6dp" android:paddingEnd="6dp"
    android:scrollbars="none"/>
  <TextView android:id="@+id/single_completed"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:visibility="gone"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:text="▸ Completed items"
    android:textSize="13sp"
    android:textColor="#BEC6B8"
    android:contentDescription="Show or hide completed checklist items"/>
  <TextView android:id="@+id/single_empty" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:gravity="center"
    android:padding="14dp" android:text="Choose a note to show here"
    android:textColor="#677363" android:textSize="13sp"/>
</LinearLayout>
